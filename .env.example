# ─────────────────────────────────────────────────────────────────────────────
# AdraConnects — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your Supabase project credentials.
# NEVER commit .env, .env.local, or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase publishable (anon) values — safe for client-side code.
# Find them in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_KEY=sb_publishable_REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — These must NEVER be exposed in client-side code.
# They are only used by migration scripts or CI/CD pipelines.
# ─────────────────────────────────────────────────────────────────────────────
# POSTGRES_PASS=               # Direct DB password (migration scripts only)
# CLIENT_ID=                   # OAuth client ID (if using Google auth)
# CLIENT_SECRET=               # OAuth client secret (NEVER in client bundle)
